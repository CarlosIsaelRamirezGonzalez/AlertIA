# Copia este archivo como .env y llena los valores. .env nunca se sube a GitHub.

# Flask
FLASK_APP=flasky.py
FLASK_DEBUG=1
FLASK_CONFIG=development
SECRET_KEY=

# MongoDB (local o Atlas)
MONGODB_URI=mongodb://localhost:27017

# Correo (Gmail con contraseña de aplicación)
MAIL_USERNAME=
MAIL_PASSWORD=
FLASKY_ADMIN=
SUPPORT_EMAIL=

# Google Maps (para elegir la ubicación de una cámara)
GOOGLE_MAPS_API_KEY=

# Twilio (SMS; el envío está desactivado en el código)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Dirección pública de la app, para los enlaces de los correos
ALERTAI_BASE_URL=http://127.0.0.1:5000

# Modelo de IA; por defecto Artificial_Intelligence/Aria.keras
ALERTAI_MODEL_PATH=
